# Copy to `.env` and fill in AZP_TOKEN. `.env` is gitignored — never commit a PAT.

# Azure DevOps PAT with the "Agent Pools (Read & manage)" scope.
AZP_TOKEN=

# Azure DevOps organization URL.
AZP_URL=https://dev.azure.com/iduffy-demo

# Agent pool to register into (jobs target `pool: name: 'Default'`).
AZP_POOL=Default

# Friendly agent name shown in the pool.
AZP_AGENT_NAME=compose-local-agent
